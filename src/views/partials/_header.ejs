<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Nice Trip</title>
    <!-- NAVIGATION -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
  
    <link rel="stylesheet" href="/styles/index.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-light navColor">
      <div class="container-fluid">
        <a class="navbar-brand textColor" href="/">
          <img src="https://www.nicetrip.co.th/img/logo.png" alt="Nice Trip Logo" style="width: 90px; height: auto; margin-right: 10px;">
          Nice Trip
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavDropdown">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link active textColor" aria-current="page" href="/">Inicio</a>
            </li>
            <li class="nav-item">
              <a class="nav-link active textColor" href="/cotizar">Cotizar</a>
            </li>
            <li class="nav-item dropdown">
              <% if(!nombreUsuario){ %>
                <a class="nav-link dropdown-toggle textColor" href="#" id="navbarDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  Perfil
                </a>
                <form class="dropdown-menu p-4" aria-labelledby="navbarDropdownMenuLink" action="/login"  method="POST" style="width: 200px;">
                  <div class="form-group">
                    <label for="correo">Correo</label>
                    <input type="email" class="form-control" name="correo" id="correo" placeholder="ejemplo@test.com">
                  </div>
                  <div class="form-group">
                    <label for="clave">Clave</label>
                    <input type="password" class="form-control" name="clave" id="clave" placeholder="****">
                  </div>
                  <a href="#" class="" data-bs-toggle="modal" data-bs-target="#registrarseModal">Registrarse</a> <br>
                  <button type="submit" class="btn btn-primary mt-2">Iniciar</button>
                </form>
                <% } else { %>
                  <a class="nav-link dropdown-toggle textColor" href="#" id="navbarDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <%= nombreUsuario %>
                  </a>
                  <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                    <li><a class="dropdown-item" href="/mis-reservas">Mis Reservas</a></li>
                    <li><a class="dropdown-item" href="/cerrar">Cerrar Sesion</a></li>
                  </ul>
                <% } %>
            </li>
          </ul>
        </div>
      </div>
    </nav>
    <% if(error){ %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <% } %>

      <div class="modal fade" id="registrarseModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Rgistro</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div>
                  <form class="container float-start">
                    <p>Mejores beneficios al registrarte!</p>
                    <div class="row mt-2 g-2">
                      <div class="col-md-6">
                        <div class="form-floating">
                          <input type="text" class="form-control" id="nombreProfile" required>
                          <label for="noDias">Nombre</label>
                        </div>
                      </div>
                      <div class="col-md-6">
                        <div class="form-floating">
                          <input type="text" class="form-control" id="apellidoProfile" required>
                          <label for="totalPagar">Apellido</label>
                        </div>
                      </div>
                    </div>
                    <div class="row mt-2 g-2">
                      <div class="col-md-7">
                        <div class="form-floating">
                          <input type="text" class="form-control" id="direccionProfile" required>
                          <label for="direccion">direccion
                          </label>
                        </div>
                      </div>
                      <div class="col-md-5">
                        <div class="form-floating">
                          <input type="text" class="form-control" id="numerTelefonoProfile" pattern="[0-9]" required>
                          <label for="numeroTelefono">Numero Telefono</label>
                        </div>
                      </div>
                    </div>
                    <div class="row mt-2 g-2">
                      <div class="col-md-6">
                        <div class="form-floating">
                          <input type="text" class="form-control" id="correoProfile" placeholder="eje@test.com" required>
                          <label for="correo">Correo Electronico</label>
                        </div>
                      </div>
                      <div class="col-md-6">
                        <div class="form-floating">
                          <input type="password" class="form-control" id="passwordProfile" placeholder="****" required> 
                          <label for="password">Contraseña</label>
                        </div>
                      </div>
                    </div>
                      <div>
                        <button type="button" onclick="guardarPerfil()" id="guardarPerfilButton" class="btn btn-primary mt-2 mb-2">Guardar Perfil</button>
                      </div>
                  </form>
                </div>
            </div>
        </div>
      </div>